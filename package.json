{
  "name": "sameframe",
  "private": true,
  "type": "module",
  "scripts": {
    "install:fe": "pnpm install",
    "build:fe": "pnpm --filter sameframe-frontend run build",
    "dev:fe": "pnpm --filter sameframe-frontend run dev",
    "build": "pnpm run build:fe",
    "dev": "pnpm run build:fe && wrangler dev",
    "check": "tsrs --noEmit",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.19"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "tsrs": "7.1.0-beta.tsrs2",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:",
    "wrangler": "^4.165.0"
  }
}
