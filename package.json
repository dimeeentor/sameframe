{
  "name": "sameframe",
  "private": true,
  "type": "module",
  "scripts": {
    "install:fe": "pnpm install",
    "build:fe": "pnpm --filter sameframe-frontend run build",
    "dev:fe": "pnpm --filter sameframe-frontend run dev",
    "build": "pnpm run build:fe",
    "dev": "pnpm run build:fe && wrangler dev",
    "check": "tsc --noEmit",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.148.0"
  }
}
