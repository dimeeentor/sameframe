{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sameframe",
  "main": "api/server.ts",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomDurableObject" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDurableObject"] },
  ],
}
